{
  "name": "dsh-workspace-instructions",
  "version": "0.1.1",
  "private": true,
  "description": "Per-session workspace instruction file selection for DeepSeek Harness: choose which markdown file the workspace AGENTS.md slot loads, pick it with the native file dialog, and show it beside the session title.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-bundle",
    "agent-instructions",
    "AGENTS.md"
  ],
  "author": "yedanten",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yedanten/dsh-workspace-instructions.git"
  },
  "homepage": "https://github.com/yedanten/dsh-workspace-instructions#readme",
  "bugs": {
    "url": "https://github.com/yedanten/dsh-workspace-instructions/issues"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT"
}
